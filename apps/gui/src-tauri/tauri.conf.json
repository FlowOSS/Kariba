{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kariba",
  "version": "0.1.0",
  "identifier": "com.flowoss.kariba",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kariba",
        "width": 1120,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
